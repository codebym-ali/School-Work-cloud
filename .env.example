# ─────────────────────────────────────────────────────────────
# Copy to .env for local dev. NEVER commit .env.
# In production these are set as Coolify environment/secret vars.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Dev API port is 4000 (3000 is commonly taken by other local projects, e.g. Goex).
API_PORT=4000
# Platform apex used for subdomain tenancy: {slug}.APP_APEX_DOMAIN
# The port here is the BROWSER-facing one (the web app, :3001 in dev) — tenant resolution and the
# cookie domain strip it, but links the product hands to a human are built from it.
APP_APEX_DOMAIN=localhost:3001
# Reserved subdomain labels that never resolve to a tenant (blueprint §21.1)
RESERVED_SUBDOMAINS=www,api,admin,app

# ── Database (blueprint §21.5) ────────────────────────────────
# app_user: the API/worker connection. MUST NOT have BYPASSRLS.
DATABASE_URL=postgresql://app_user:app_pw@localhost:5433/school?schema=public
# platform_admin: BYPASSRLS, read-mostly. Used ONLY by vendor console,
# cross-tenant jobs, and tenant-export. Never given to request-path client.
PLATFORM_DATABASE_URL=postgresql://platform_admin:platform_pw@localhost:5433/school?schema=public
# Superuser used only for migrations / SQL companions (RLS is FORCE'd, so DDL needs owner).
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/school?schema=public

# ── Redis / BullMQ ────────────────────────────────────────────
REDIS_URL=redis://localhost:6381

# ── Auth / JWT (blueprint §22) ────────────────────────────────
# Two keys active during quarterly rotation, selected by `kid`.
JWT_ACTIVE_KID=k1
JWT_KEYS='{"k1":"dev-only-change-me-32b-minimum-secret","k2":"dev-only-change-me-secondary-secret"}'
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# true in production (HTTPS). NOTE: keep comments on their OWN line — docker `env_file`
# / `--env-file` do NOT strip inline `# ...` comments (they'd become part of the value).
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ── Field-level encryption (blueprint §32) ────────────────────
# AES-256-GCM master key (32 bytes, base64). Replaces AWS KMS on this stack.
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=REPLACE_WITH_openssl_rand_base64_32

# ── Object storage: Cloudflare R2 (S3-compatible) ─────────────
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=school-uploads
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_FORCE_PATH_STYLE=true
# Local dev uses MinIO instead (docker-compose):
# S3_ENDPOINT=http://localhost:9002  S3_ACCESS_KEY_ID=minioadmin  S3_SECRET_ACCESS_KEY=minioadmin

# ── Antivirus scan for uploads (blueprint §22.6) ──────────────
# Off by default. When true, uploads are streamed to clamd (INSTREAM) on confirm;
# an infected file is rejected (422 FILE_INFECTED) and a scanner outage fails closed
# (503). Local: docker compose up -d clamav  (clamd on :3310; first start pulls the DB).
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── SMS gateway (blueprint §26 — pluggable adapter) ───────────
# console | telenor | jazz  (console just logs, for dev)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
SMS_WEBHOOK_HMAC_SECRET=dev-webhook-secret

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=debug
# Error monitoring (§31). Leave blank to keep Sentry OFF (dev/test/CI). Set the DSN
# in production to capture unhandled 500s + failed worker jobs with tenant context.
SENTRY_DSN=
# Optional performance tracing sample rate 0..1 (default 0 = errors only).
SENTRY_TRACES_SAMPLE_RATE=

# ── Backups / WAL archiving → R2 (blueprint §33; see DR Runbook) ──────────────
# The nightly logical dump (backup-postgres.sh), physical base backup (basebackup.sh),
# and restore-verify (restore-verify.sh) read these. Set them as Coolify env in prod.
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=school-backups
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
# Durable WAL archiving off-box (docker-compose.prod.yml postgres): flip to true in prod so
# point-in-time recovery survives host loss. Leave false for local — WAL archives on-box only.
WAL_R2_ENABLED=false
# S3 provider for rclone's WAL remote: Cloudflare (R2) in prod, Minio for a local S3 test.
RCLONE_CONFIG_R2_PROVIDER=Cloudflare

# Signs payment-aggregator settlement callbacks (Kuickpay / 1Bill / 1LINK — Fee Submission Plan
# §5.3). LEAVE UNSET until a merchant agreement exists: with no secret the webhook refuses every
# call, which is the correct posture for a seam that is not integrated. Setting it does NOT make
# settlement work — see the note in aggregator.service.ts.
# AGGREGATOR_WEBHOOK_HMAC_SECRET=
