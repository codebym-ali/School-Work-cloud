{
  "name": "school-management",
  "version": "0.1.0",
  "description": "Multi-tenant school management SaaS (NestJS + Prisma + Postgres RLS)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "build": "nest build api && nest build worker",
    "start:api": "nest start api",
    "start:api:dev": "nest start api --watch",
    "start:worker": "nest start worker",
    "start:worker:dev": "nest start worker --watch",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json --noEmit",
    "lint:fe": "pnpm -r --filter \"./apps/*\" lint",
    "typecheck:fe": "pnpm -r --filter \"./apps/*\" typecheck",
    "lint:packages": "eslint \"packages/**/*.{ts,tsx}\" --quiet",
    "verify": "pnpm lint && pnpm lint:packages && pnpm typecheck && pnpm typecheck:e2e && pnpm typecheck:fe && pnpm lint:fe && pnpm test:unit",
    "ci:local": "bash scripts/ci-local.sh",
    "hooks:install": "node scripts/install-hooks.mjs",
    "format": "prettier --write \"{apps,libs,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:regen": "node scripts/db-regen.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:sql": "node --env-file-if-exists=.env scripts/apply-sql-companions.mjs",
    "db:check-rls": "node --env-file-if-exists=.env scripts/check-rls-coverage.mjs",
    "db:check-migrations": "node scripts/check-migration-safety.mjs",
    "db:setup": "pnpm db:check-migrations && prisma migrate deploy && pnpm db:sql && pnpm db:check-rls",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:isolation",
    "test:unit": "jest --selectProjects unit --passWithNoTests",
    "test:integration": "jest --selectProjects integration --runInBand --forceExit",
    "test:isolation": "jest --selectProjects isolation --runInBand --forceExit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1080.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/throttler": "^6.2.0",
    "@prisma/client": "^5.20.0",
    "@sentry/node": "^8",
    "argon2": "^0.41.1",
    "bullmq": "^5.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "nestjs-cls": "^4.4.1",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^9.0.6",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino-http": "^10.3.0",
    "prisma": "^5.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@playwright/test": "^1.61.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
