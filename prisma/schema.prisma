// ── Bell schedule (the school's own clock) ───────────────────────────────────
/// What a school day looks like: which periods exist, when they start, and where the breaks fall.
///
/// `TimetableSlot` says *what* happens in period 3 and could never say *when*: `period_no` is a bare
/// ordinal, and the grid inferred how many periods a class had from `max(period_no)` over whatever
/// somebody had already typed, floored at 6. So an 8-period school saw 6 rows, a break could not be
/// represented at all, and Friday — a short day in almost every school here — rendered exactly like
/// Tuesday, with its empty cells unable to say whether they were unfilled or non-existent.
///
/// **Exactly one schedule resolves for any section in any academic year** (a schedule listing its
/// class, else the campus default). That is what keeps `period_no` meaning one thing, and it is
/// enforced at write time by `bell_schedule_classes.@@unique([classId, scheduleId])` plus the
/// one-default-per-campus partial index — never resolved by precedence at read time.
model BellSchedule {
  id             String              @id @default(uuid()) @db.Uuid
  schoolId       String              @map("school_id") @db.Uuid
  school         School              @relation(fields: [schoolId], references: [id])
  campusId       String              @map("campus_id") @db.Uuid
  campus         Campus              @relation(fields: [campusId, schoolId], references: [id, schoolId])
  /// Year-scoped like `TimetableSlot`. Without this, reading last year's grid would resolve against
  /// THIS year's bell — two models that must agree, scoped differently.
  academicYearId String              @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear        @relation(fields: [academicYearId, schoolId], references: [id, schoolId])
  name           String              @db.VarChar(60) // "Regular", "Primary Wing"
  /// The campus fallback: used by any class not named on a wing schedule. One per campus+year
  /// (partial unique in SQL).
  ///
  /// Stored rather than derived from "has no classes attached", because a partial index predicate
  /// cannot reach into another table — so deriving it would leave the rule enforceable only in the
  /// service, and the F0 accountant seat established the house rule that a uniqueness invariant gets
  /// both layers: the index is the safety under a race, the service check is what makes the refusal
  /// civil. A default carries no classes; a non-default must carry at least one, or it is unreachable.
  isDefault      Boolean             @default(false) @map("is_default")
  classes        BellScheduleClass[]
  periods        BellPeriod[]
  deletedAt      DateTime?           @map("deleted_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([id, schoolId])
  @@index([schoolId, campusId, academicYearId])
  @@map("bell_schedules")
}

/// Which classes follow a non-default schedule — the "wing override" (Primary out at 12:30).
///
/// ⚠️ **EXPLICIT join model, never `classes Class[]`.** An *implicit* Prisma many-to-many creates a
/// join table carrying only `A`/`B` columns and **no `school_id`** — so `prisma/sql/05_rls.sql`,
/// which loops tables that have `school_id`, gives it no policy; the Prisma tenant extension has
/// nothing to merge into; and `scripts/check-rls-coverage.mjs` never even considers it, because that
/// query starts from `WHERE column_name = 'school_id'`. All three isolation layers share one
/// assumption and would have failed together. Every m2m in this schema is explicit and tenant-chained
/// for exactly this reason — see `SectionSubject`, `StudentGuardian`, `TeacherAssignment`.
model BellScheduleClass {
  id         String       @id @default(uuid()) @db.Uuid
  schoolId   String       @map("school_id") @db.Uuid
  school     School       @relation(fields: [schoolId], references: [id])
  scheduleId String       @map("schedule_id") @db.Uuid
  schedule   BellSchedule @relation(fields: [scheduleId, schoolId], references: [id, schoolId], onDelete: Cascade)
  classId    String       @map("class_id") @db.Uuid
  class      Class        @relation(fields: [classId, schoolId], references: [id, schoolId])
  createdAt  DateTime     @default(now()) @map("created_at")

  /// A class sits in at most one schedule — resolution decided at write time, never at read time.
  /// (Scoped per schedule here; the cross-schedule rule is checked in the service, since a class
  /// could otherwise be attached to two schedules of the same campus+year.)
  @@unique([classId, scheduleId])
  @@index([schoolId, scheduleId])
  @@index([classId, schoolId])
  @@map("bell_schedule_classes")
}

/// One row of one day — a teaching period, or a break/assembly.
///
/// `dayOfWeek` sits here rather than on a day parent so that **every day is composed independently**:
/// Friday is not a flag or a special case, it is simply a day built with fewer rows.
///
/// ⚠️ `startTime`/`endTime` are **computed by the server**, never sent by the client. The write takes
/// the day's start plus each row's duration and walks the list, so a gap or an overlap is not
/// "rejected" — it is inexpressible. `sequence` and `periodNo` are assigned for the same reason: a
/// hand-typed period number is how you get a period 7 that no bell rings for.
model BellPeriod {
  id         String       @id @default(uuid()) @db.Uuid
  schoolId   String       @map("school_id") @db.Uuid
  school     School       @relation(fields: [schoolId], references: [id])
  scheduleId String       @map("schedule_id") @db.Uuid
  schedule   BellSchedule @relation(fields: [scheduleId, schoolId], references: [id, schoolId], onDelete: Cascade)
  dayOfWeek  Int          @map("day_of_week") // 1=Mon … 7=Sun, matching TimetableSlot
  sequence   Int // order down the day, breaks included
  /// The only distinction that carries behaviour. A break and an assembly differ by `label`, not by
  /// anything the system does — an enum here would have been three untested branches.
  isTeaching Boolean      @map("is_teaching")
  /// Teaching rows only, numbered 1..n down the day. This is what `TimetableSlot.periodNo` refers to.
  ///
  /// ⚠️ Nullable, and **Postgres treats NULLs as DISTINCT** — which is exactly right for breaks (a day
  /// may hold several) and useless for teaching rows, where a plain unique key would NOT stop two
  /// period-3s. Hence the partial index in `02_partial_uniques.sql`. Third appearance of this one
  /// behaviour in this schema: relied on for `fee_invoices.psid`, a hole in `cover_assignments`, and
  /// both at once here.
  periodNo   Int?         @map("period_no")
  label      String?      @db.VarChar(30) // "Break", "Lunch", "Assembly", "Jumma"
  /// School-local wall clock, "HH:MM". VarChar rather than `@db.Time` deliberately: zero-padded
  /// HH:MM sorts lexicographically in chronological order, it is how every other clock value in this
  /// product is already represented (`attendanceMarkByTime`, `staffAttendance.dayStartTime`), and the
  /// existing `isPastLocalTime()`/`localHhMm()` helpers take it unchanged. `@db.Time` would hand
  /// TypeScript a Date on 1970-01-01 that every call site has to strip. Format is CHECKed in SQL.
  startTime  String       @map("start_time") @db.VarChar(5)
  endTime    String       @map("end_time") @db.VarChar(5)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([scheduleId, dayOfWeek, sequence])
  @@index([schoolId, scheduleId, dayOfWeek])
  @@map("bell_periods")
}

// ── Timetable (v1: assignments feed it; visual grid v1.5) ────────────────────
/// One period of one section's week.
///
/// Until 2026-08-08 this model carried **raw ids and no relations at all**, which made it a table
/// nothing could write and nothing could read usefully: no endpoint existed, no join was possible,
/// and the only code touching it anywhere was two `count()` calls in delete-guards asking whether
/// a section or subject had slots — a number that was structurally always zero. Relations added so
/// a grid can be rendered, and **foreign keys** so a slot cannot outlive the subject it teaches or
/// the teacher who left.
model TimetableSlot {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId])
  sectionId      String       @map("section_id") @db.Uuid
  section        Section      @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  dayOfWeek      Int          @map("day_of_week") // 1=Mon … 7=Sun
  periodNo       Int          @map("period_no")
  subjectId      String       @map("subject_id") @db.Uuid
  subject        Subject      @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  staffId        String       @map("staff_id") @db.Uuid
  staff          StaffProfile @relation(fields: [staffId, schoolId], references: [id, schoolId])
  /// Optional free text — "Lab 2", "Ground". Schools that do not track rooms leave it null rather
  /// than being made to invent one.
  room           String?      @db.VarChar(40)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  /// One section cannot be taught two things at once — enforced by the database, not by a check
  /// the API could forget. The teacher-side clash has no equivalent constraint because a teacher
  /// legitimately appears in many sections; it is asserted in the service (§10 of the plan).
  @@unique([sectionId, academicYearId, dayOfWeek, periodNo])
  @@index([schoolId, staffId, dayOfWeek]) // teacher clash check
  @@index([schoolId, academicYearId, sectionId])
  @@index([subjectId, schoolId])
  @@index([staffId, schoolId])
  @@map("timetable_slots")
}

/// Who is taking a class today, when the teacher who normally does is not there (Cover Plan).
///
/// Before this, a substitute standing in the room could not mark the register at all —
/// `assertCanMark` requires a `TeacherAssignment`, so they got "You are not assigned to this
/// section" and only an admin could close it. This row is what makes them able to.
///
/// ⚠️ **It is a permission grant, not a note.** It gives one person write access to another
/// class's register, on data that feeds pay and defaulter reporting, and it can be backdated —
/// so creating and removing it are both audited, and it is refused into a month whose payroll is
/// APPROVED.
model CoverAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  /// One day. Cover is not a contract — a fortnight of absence is fourteen rows, so the model
  /// stays simple and the UI does the repetition.
  date      DateTime @db.Date
  sectionId String   @map("section_id") @db.Uuid
  section   Section  @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  /// NULL when the school runs no timetable — then it means "cover 9-A all day", which is how a
  /// school without a published grid actually works. `timetable_slots` shipped with zero rows in
  /// every school, so requiring a period would have made this unusable where it is needed most.
  periodNo  Int?     @map("period_no")

  coveringStaffId String        @map("covering_staff_id") @db.Uuid
  coveringStaff   StaffProfile  @relation("CoverCovering", fields: [coveringStaffId, schoolId], references: [id, schoolId])
  /// Who is away. Nullable on purpose: a class can need someone for reasons the register does not
  /// know — a teacher pulled into a meeting — and refusing to record cover without a matching
  /// absence would make the office lie to the system in order to use it.
  absentStaffId   String?       @map("absent_staff_id") @db.Uuid
  absentStaff     StaffProfile? @relation("CoverAbsent", fields: [absentStaffId, schoolId], references: [id, schoolId])

  reason       String? @db.VarChar(200)
  /// The admin who decided. This is who granted the access, so it is never nullable.
  arrangedById String  @map("arranged_by_id") @db.Uuid
  arrangedBy   User    @relation("CoverArrangedBy", fields: [arrangedById, schoolId], references: [id, schoolId])

  createdAt DateTime @default(now()) @map("created_at")

  /// ⚠️ No `@@unique` here on purpose. "One cover per section per period" cannot be expressed as a
  /// plain unique index while `periodNo` is nullable — Postgres treats NULLs as DISTINCT, so two
  /// whole-day covers for the same section on the same date would both be accepted, which is
  /// exactly what the constraint would exist to stop. Two PARTIAL unique indexes do it instead,
  /// in `prisma/sql/02_partial_uniques.sql`.
  @@index([schoolId, coveringStaffId, date])
  @@index([schoolId, sectionId, date])
  @@index([absentStaffId, schoolId])
  @@index([arrangedById, schoolId])
  @@map("cover_assignments")
}

// ── HR / payroll ─────────────────────────────────────────────────────────────
model SalaryStructure {
  id              String       @id @default(uuid()) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  staffId         String       @map("staff_id") @db.Uuid
  staff           StaffProfile @relation(fields: [staffId, schoolId], references: [id, schoolId])
  basic           Decimal      @db.Decimal(12, 2)
  allowances      Json         @default("{}") // { "House Rent": 5000 }
  fixedDeductions Json         @default("{}") @map("fixed_deductions")
  effectiveFrom   DateTime     @map("effective_from") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([schoolId, staffId, effectiveFrom])
  @@map("salary_structures")
}

model PayrollRun {
  id           String           @id @default(uuid()) @db.Uuid
  schoolId     String           @map("school_id") @db.Uuid
  campusId     String           @map("campus_id") @db.Uuid
  month        Int
  year         Int
  status       PayrollRunStatus @default(DRAFT)
  approvedById String?          @map("approved_by_id") @db.Uuid
  approvedBy   User?            @relation("PayrollRunApprovedBy", fields: [approvedById, schoolId], references: [id, schoolId])
  createdById  String           @map("created_by_id") @db.Uuid
  createdBy    User             @relation("PayrollRunCreatedBy", fields: [createdById, schoolId], references: [id, schoolId])
  createdAt    DateTime         @default(now()) @map("created_at")

  payslips Payslip[]

  @@unique([id, schoolId]) // composite target for Payslip tenant-chain FK
  @@unique([schoolId, campusId, month, year])
  @@index([approvedById, schoolId])
  @@index([createdById, schoolId])
  @@map("payroll_runs")
}

model Payslip {
  id                  String         @id @default(uuid()) @db.Uuid
  schoolId            String         @map("school_id") @db.Uuid
  runId               String         @map("run_id") @db.Uuid
  run                 PayrollRun     @relation(fields: [runId, schoolId], references: [id, schoolId])
  staffId             String         @map("staff_id") @db.Uuid
  staff               StaffProfile   @relation(fields: [staffId, schoolId], references: [id, schoolId])
  gross               Decimal        @db.Decimal(12, 2)
  attendanceDeduction Decimal        @default(0) @map("attendance_deduction") @db.Decimal(12, 2)
  otherDeductions     Decimal        @default(0) @map("other_deductions") @db.Decimal(12, 2)
  netPay              Decimal        @map("net_pay") @db.Decimal(12, 2)
  breakdown           Json // full line-item detail for the PDF
  paidAt              DateTime?      @map("paid_at")
  paymentMethod       PaymentMethod? @map("payment_method")
  paymentRef          String?        @map("payment_ref")
  /// Who recorded the payment. For cash this IS the record — there is no bank trail. Null on rows paid before
  /// it was captured. No FK: a departed accountant's user must neither block nor cascade into payroll history.
  paidById            String?        @map("paid_by_id") @db.Uuid

  @@unique([runId, staffId])
  @@index([schoolId, staffId])
  @@index([runId, schoolId])
  @@map("payslips")
}

// Recruitment: a job opening at a campus. Entry point of the hiring workflow (HR module).

// Teacher application / onboarding form (HR module). Queryable fields are real columns;
// the full form (personal, contact, education, experience, skills) persists in `details`.

/// Per-user module (functionality) access override. A granted role (e.g. HR_MANAGER) unlocks
/// its modules by default; the owner can switch a specific module off for one user by writing
/// an `allowed=false` row here. Absence of a row = allowed (so grants stay fully enabled until
/// the owner restricts them). Enforced in-service via AccessService.assert (§22.8 pattern).
model ModuleAccess {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  moduleKey String   @map("module_key")
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, moduleKey])
  @@index([schoolId])
  @@index([userId, schoolId])
  @@map("module_access")
}

// ── Communication ────────────────────────────────────────────────────────────
model SmsTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id])
  triggerKey  String   @map("trigger_key") // FEE_REMINDER | FEE_RECEIPT | ABSENCE | RESULT_READY | LEAVE_STATUS | ACCOUNT_INVITE | MANUAL
  body        String // with {placeholders}
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById, schoolId], references: [id, schoolId])
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([schoolId, triggerKey])
  @@index([updatedById, schoolId])
  @@map("sms_templates")
}

model SmsLog {
  id               String    @id @default(uuid()) @db.Uuid
  schoolId         String    @map("school_id") @db.Uuid
  school           School    @relation(fields: [schoolId], references: [id])
  recipient        String
  studentId        String?   @map("student_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  invoiceId        String?   @map("invoice_id") @db.Uuid
  templateKey      String    @map("template_key")
  message          String
  segments         Int       @default(1)
  status           SmsStatus @default(QUEUED)
  gatewayMessageId String?   @map("gateway_message_id")
  failReason       String?   @map("fail_reason")
  sentAt           DateTime? @map("sent_at")
  deliveredAt      DateTime? @map("delivered_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  /// Idempotency claim for redelivered queue jobs (BullMQ retries / stalled-worker recovery).
  /// Set only for sends that are naturally once-per-event; NULL for everything else, and
  /// Postgres treats NULLs as distinct so unlimited NULL rows coexist under the unique index.
  dedupeKey        String?   @map("dedupe_key")

  @@unique([schoolId, dedupeKey])
  @@index([schoolId, status])
  @@index([schoolId, createdAt]) // purge job
  @@index([gatewayMessageId]) // webhook lookup
  @@map("sms_logs")
}

model SmsCreditLedger {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  delta     Int // + top-up, − send debit
  refType   String   @map("ref_type") // PLAN_MONTHLY | PURCHASE | SEND
  refId     String?  @map("ref_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@map("sms_credit_ledger")
}

// ── Documents ────────────────────────────────────────────────────────────────
model Document {
  id         String       @id @default(uuid()) @db.Uuid
  schoolId   String       @map("school_id") @db.Uuid
  school     School       @relation(fields: [schoolId], references: [id])
  studentId  String?      @map("student_id") @db.Uuid
  staffId    String?      @map("staff_id") @db.Uuid
  type       DocumentType
  fileKey    String       @map("file_key") // S3/R2 key
  issuedById String       @map("issued_by_id") @db.Uuid
  issuedBy   User         @relation(fields: [issuedById, schoolId], references: [id, schoolId])
  issuedAt   DateTime     @default(now()) @map("issued_at")

  @@index([schoolId, studentId])
  @@index([issuedById, schoolId])
  @@map("documents")
}

/// Documents RECEIVED from a family at admission — the counter-side checklist.
///
/// ⚠️ Deliberately NOT the `Document` model above. That one records what the school ISSUES
/// (leaving certificate, report card, payslip): it carries `issuedById`/`issuedAt` and every
/// `DocumentType` is a school-produced artifact. Receipt is the opposite direction, with a
/// different actor and a different question ("did we get it?"), and forcing both through one table
/// would make either side lie.
model StudentDocument {
  id           String              @id @default(uuid()) @db.Uuid
  schoolId     String              @map("school_id") @db.Uuid
  school       School              @relation(fields: [schoolId], references: [id])
  studentId    String              @map("student_id") @db.Uuid
  student      Student             @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  type         StudentDocumentType
  /// Tri-state via the row's existence + this flag: no row = never asked, false = asked and not
  /// received, true = in hand. Same reasoning as `slcReceived` on the student.
  received     Boolean             @default(false)
  receivedAt   DateTime?           @map("received_at")
  receivedById String?             @map("received_by_id") @db.Uuid
  receivedBy   User?               @relation(fields: [receivedById, schoolId], references: [id, schoolId])
  /// ⚠️ OPTIONAL, and it must stay optional. In a Pakistani school these arrive as photocopies
  /// across a counter far more often than as scans. Requiring an upload to tick the box would make
  /// the checklist unusable and push the office into ticking things that are not true — a register
  /// that lies is worse than no register.
  fileKey      String?             @map("file_key")
  note         String?
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([studentId, type])
  @@index([schoolId, studentId])
  @@map("student_documents")
}

/// One uploaded bank statement (Fees Gaps Register — reconciliation).
///
/// The school's accountant downloads the day's statement from their bank and uploads it here. This
/// row is the upload itself; the money lives in `BankStatementLine`.
model BankStatement {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id])

  /// Which bank this came from — also the key the column mapping is remembered against, so the
  /// second upload from the same bank needs no mapping.
  bankLabel  String    @map("bank_label")
  /// The original filename, purely so a human can recognise their own upload in a list.
  fileName   String?   @map("file_name")
  periodFrom DateTime? @map("period_from") @db.Date
  periodTo   DateTime? @map("period_to") @db.Date
  lineCount  Int       @default(0) @map("line_count")

  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?    @relation("StatementUploadedBy", fields: [uploadedById, schoolId], references: [id, schoolId])
  createdAt    DateTime @default(now()) @map("created_at")

  lines BankStatementLine[]

  @@index([schoolId, createdAt])
  @@map("bank_statements")
}

/// One credit line from a bank statement.
///
/// ⚠️ **Lines PERSIST whether or not they match.** A credit with no claim today may acquire one on
/// Thursday, when the parent finally gets round to submitting. Match-and-discard would lose that —
/// and the unmatched set is the most valuable output of the whole feature: money the school has
/// received and cannot explain, often belonging to a child sitting on a defaulter list.
model BankStatementLine {
  id          String        @id @default(uuid()) @db.Uuid
  schoolId    String        @map("school_id") @db.Uuid
  school      School        @relation(fields: [schoolId], references: [id])
  statementId String        @map("statement_id") @db.Uuid
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  /// The bank's value date — the day the money moved, which is what a claim's `paidOn` is compared
  /// against. Not the upload date.
  valueDate    DateTime @map("value_date") @db.Date
  amount       Decimal  @db.Decimal(12, 2)
  /// The bank's free-text narration. Kept whole: references are routinely buried inside it
  /// (`IBFT/TX88231/AYESHA`), and the tier-2 matcher reads it.
  narration    String   @db.VarChar(500)
  /// A reference the bank exposed as its own column, when it did.
  reference    String?
  counterparty String?  @db.VarChar(200)

  /// ⚠️ Hash of (valueDate, amount, reference, narration). UNIQUE per school, so re-uploading the
  /// same statement — or an overlapping date range, which is what people actually do — writes
  /// nothing. The same discipline as `Idempotency-Key` on payments.
  fingerprint String

  /// The claim this line corroborates. One line may settle SEVERAL claims (a parent paying for two
  /// siblings in one transfer), which is why the link lives on the claim side too.
  matchedClaimId String?          @map("matched_claim_id") @db.Uuid
  matchedClaim   FeePaymentClaim? @relation(fields: [matchedClaimId, schoolId], references: [id, schoolId])
  matchedAt      DateTime?        @map("matched_at")

  createdAt DateTime @default(now()) @map("created_at")

  /// One line corroborates at most one claim; the composite keeps the relation tenant-safe.
  @@unique([matchedClaimId, schoolId])
  @@unique([schoolId, fingerprint])
  @@index([schoolId, valueDate])
  @@index([schoolId, matchedClaimId])
  @@map("bank_statement_lines")
}

// ── Platform / cross-cutting ─────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  school     School   @relation(fields: [schoolId], references: [id])
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId, schoolId], references: [id, schoolId])
  action     String // enum-like constant catalog in code: audit-actions.ts
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([schoolId, createdAt])
  @@index([schoolId, userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  key          String
  requestHash  String   @map("request_hash")
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([schoolId, key])
  @@index([createdAt]) // 48h purge job
  @@map("idempotency_keys")
}

// ── Class tests (formative assessment, §11 extension) ────────────────────────
/// A quiz or class test set by the subject teacher. DELIBERATELY NOT an ExamDefinition:
/// an exam carries `weightagePercent` that must sum to 100 per class and feeds report-card
/// generation, so every ad-hoc quiz created as an exam would break the report card. These are
/// formative — teacher feedback, monthly performance tracking — and never enter a report card.
model ClassTest {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id])
  sectionId   String   @map("section_id") @db.Uuid
  section     Section  @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  subjectId   String   @map("subject_id") @db.Uuid
  subject     Subject  @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  name        String
  /// Marks the test is out of. Tests differ (10, 50), so every rollup normalises to a percentage.
  totalMarks  Decimal  @map("total_marks") @db.Decimal(6, 2)
  testDate    DateTime @map("test_date") @db.Date
  createdById String?  @map("created_by_id") @db.Uuid
  createdBy   User?    @relation(fields: [createdById, schoolId], references: [id, schoolId])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  scores ClassTestScore[]

  @@unique([id, schoolId])
  @@index([schoolId, sectionId, testDate])
  @@index([schoolId, subjectId, testDate])
  @@index([subjectId, schoolId])
  @@index([createdById, schoolId])
  @@map("class_tests")
}

model ClassTestScore {
  id            String            @id @default(uuid()) @db.Uuid
  schoolId      String            @map("school_id") @db.Uuid
  school        School            @relation(fields: [schoolId], references: [id])
  classTestId   String            @map("class_test_id") @db.Uuid
  classTest     ClassTest         @relation(fields: [classTestId, schoolId], references: [id, schoolId], onDelete: Cascade)
  enrollmentId  String            @map("enrollment_id") @db.Uuid
  enrollment    StudentEnrollment @relation(fields: [enrollmentId, schoolId], references: [id, schoolId])
  /// Null when absent. Absences are EXCLUDED from averages rather than scored 0 — a sick child
  /// is not a failing child, and attendance already answers "were they there?".
  marksObtained Decimal?          @map("marks_obtained") @db.Decimal(6, 2)
  isAbsent      Boolean           @default(false) @map("is_absent")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@unique([classTestId, enrollmentId])
  @@unique([id, schoolId])
  @@index([schoolId, classTestId])
  @@index([enrollmentId, schoolId])
  @@map("class_test_scores")
}

/// Single-use MFA recovery codes (§22.5). MFA is MANDATORY for OWNER_ADMIN, OPERATIONS_ADMIN and ACCOUNTANT, so
/// without these a lost authenticator locks a school out of its own system and the only remedy
/// is an operator editing `mfa_enabled` in the database by hand.
///
/// Stored as argon2 hashes exactly like passwords: the plaintext is shown ONCE at generation and
/// is unrecoverable afterwards. A code is consumed on use (`used_at`), never reusable.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  school    School    @relation(fields: [schoolId], references: [id])
  userId    String    @map("user_id") @db.Uuid
  // Cascade: a recovery code exists only to recover THIS user's second factor, so it must
  // not outlive the account. Declared here as well as in the migration, or every `migrate diff`
  // reports the mismatch as drift.
  user      User      @relation(fields: [userId, schoolId], references: [id, schoolId], onDelete: Cascade)
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, schoolId])
  @@index([schoolId, userId, usedAt])
  @@map("mfa_recovery_codes")
}
