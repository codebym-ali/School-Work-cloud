// ─────────────────────────────────────────────────────────────────────────────
// Multi-Tenant School Management System — authoritative Prisma schema.
// Source of truth: school-management-master-blueprint.md §17.
//
// Conventions (mandatory, §17):
//  • every model @@maps to a snake_case table; every field @maps to snake_case
//  • PKs: String @id @default(uuid()) @db.Uuid
//  • every tenant table's first scalar is schoolId with a real relation to School
//  • money is Decimal @db.Decimal(12,2); soft delete via deletedAt where noted
//  • child rows carry a composite FK (parentId, schoolId) -> parent @@unique([id, schoolId])
//    so the DB itself guarantees the tenant chain (audit H-3)
//
// Constraints Prisma cannot express (partial uniques, CHECKs, RLS) live in
// prisma/sql/*.sql and are applied by scripts/apply-sql-companions.mjs (§17.1).
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: app_user (NOBYPASSRLS) — the request path is always RLS-bound.
  url       = env("DATABASE_URL")
  // Migrations / DDL run as the table owner (superuser); RLS is FORCE'd so app_user
  // stays subject to policies even though it can read/write the tables.
  directUrl = env("MIGRATION_DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────
enum Role {
  PLATFORM_ADMIN
  OWNER_ADMIN
  // The owner's operational deputy (Operations Admin Role Plan): school-wide, appointed + revocable by
  // the owner. Ranks just below OWNER_ADMIN — runs everything operational, but the owner reserves
  // appointing deputies, the owner account, and module-access toggles (the root of trust).
  OPERATIONS_ADMIN
  CAMPUS_ADMIN
  ADMISSION_CONTROLLER
  HR_MANAGER
  ACCOUNTANT
  TEACHER
  STAFF
  PARENT
  STUDENT
}

enum PlanTier {
  BASIC
  PLUS
  PRO
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum InquiryStatus {
  INQUIRY
  ENTRY_TEST_SCHEDULED
  ENTRY_TEST_PASSED
  ENTRY_TEST_FAILED
  ADMITTED
  REJECTED
  WITHDRAWN
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  RETAINED
  TRANSFERRED_OUT
  WITHDRAWN
  COMPLETED
}

/// Person-level lifecycle of a student, distinct from EnrollmentStatus (a seat in one
/// class for one year). SUSPENDED is barred from school but keeps portal visibility;
/// RESTRICTED is the inverse — still attending, portal access revoked.
enum StudentStatus {
  ACTIVE
  SUSPENDED
  RESTRICTED
  STRUCK_OFF
  WITHDRAWN
  GRADUATED
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

enum FeeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
  ADMISSION
}

enum FeeInvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum InvoiceItemType {
  FEE
  DISCOUNT
  FINE
  WAIVER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EASYPAISA
  JAZZCASH
  CARD
  CHEQUE
  ADVANCE // guardian advance/credit applied to an invoice (§12)
  /// Settled through a payment aggregator (Kuickpay / 1Bill / 1LINK): the parent pays inside
  /// their own bank app against the invoice's PSID. Unlike every other method here, an ONLINE
  /// payment is NOT a claim someone has to verify — the aggregator's webhook is the bank
  /// telling us the money moved, so it creates the FeePayment directly (Fee Submission Plan §5.3).
  ONLINE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum AttendanceSession {
  MORNING
  EVENING
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum StaffLeaveType {
  CASUAL
  SICK
  UNPAID
  OTHER
}

enum ExamType {
  MONTHLY
  MID_TERM
  FINAL
  SURPRISE_TEST
}

enum ExamStatus {
  DRAFT
  MARKS_ENTRY
  PUBLISHED
}

enum SmsStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  // Never sent on purpose: the parent opted out, or the number is unverified. Not a gateway
  // failure, so it is counted and shown apart from FAILED and can never be retried.
  WITHHELD
}

enum StaffType {
  TEACHER
  ADMIN
  ACCOUNTANT
  CLERK
  SUPPORT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

// ── Recruitment (HR module) ──────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
}

enum DocumentType {
  LEAVING_CERT
  CHARACTER_CERT
  FEE_CLEARANCE
  REPORT_CARD
  PAYSLIP
  RECEIPT
}

/// What a school actually asks a family to bring. Mirrors the admission form used across
/// Pakistani private schools rather than a generic "attachment" list.
enum StudentDocumentType {
  B_FORM // NADRA child registration certificate — the identity document
  BIRTH_CERTIFICATE
  GUARDIAN_CNIC
  PREV_SCHOOL_LEAVING // the SLC; `slcReceived` on the student is the same fact, surfaced earlier
  PREV_REPORT_CARD
  PHOTOGRAPH
  MEDICAL_RECORD
  OTHER
}

enum UserStatus {
  INVITED
  ACTIVE
  LOCKED
  DISABLED
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum DiscountStatus {
  ACTIVE
  REVOKED
}

// ── Tenant root & platform ───────────────────────────────────────────────────
model School {
  id                 String    @id @default(uuid()) @db.Uuid
  name               String
  subdomain          String    @unique
  customDomain       String?   @unique @map("custom_domain")
  planTier           PlanTier  @default(BASIC) @map("plan_tier")
  isActive           Boolean   @default(true) @map("is_active")
  suspendedAt        DateTime? @map("suspended_at")
  // SA6c: WHY the school is suspended — 'NON_PAYMENT' (dunning) vs 'MANUAL' (an operator / legal hold).
  // Null when active. Auto-reactivate-on-payment only un-suspends a NON_PAYMENT lock, never a manual one.
  suspendedReason    String?   @map("suspended_reason")
  // SA7 offboarding: `purgeAfter` is the instant the irreversible hard-delete becomes allowed
  // (a retention window, SA-P5); until then, cancelling termination reactivates. Both null normally.
  purgeAfter         DateTime? @map("purge_after")
  terminationReason  String?   @map("termination_reason")
  // SA6 vendor billing (D3): the monthly rate the VENDOR charges this school PER ACTIVE STUDENT.
  // Set by a SUPER_ADMIN/BILLING operator in the console; null = not priced yet (cannot be invoiced).
  pricePerStudent    Decimal?  @map("price_per_student") @db.Decimal(12, 2)
  grNumberMode       String    @default("AUTO") @map("gr_number_mode") // AUTO | MANUAL
  grPrefix           String    @default("") @map("gr_prefix")
  nextGrNumber       Int       @default(1) @map("next_gr_number")
  registrationNoMode String    @default("AUTO") @map("registration_no_mode") // AUTO | MANUAL
  registrationPrefix String    @default("") @map("registration_prefix")
  nextRegistrationNo Int       @default(1) @map("next_registration_no")
  nextReceiptNo      Int       @default(1) @map("next_receipt_no")
  settings           Json      @default("{}") // typed via Zod SchoolSettings in code (§17.1)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // back-relations (every tenant model)
  campuses            Campus[]
  moduleAccess        ModuleAccess[]
  academicYears       AcademicYear[]
  classes             Class[]
  sections            Section[]
  subjects            Subject[]
  sectionSubjects     SectionSubject[]
  holidays            Holiday[]
  users               User[]
  parentProfiles      ParentProfile[]
  students            Student[]
  enrollments         StudentEnrollment[]
  staffProfiles       StaffProfile[]
  teacherAssignments  TeacherAssignment[]
  timetableSlots      TimetableSlot[]
  coverAssignments    CoverAssignment[]
  bellSchedules       BellSchedule[]
  bellScheduleClasses BellScheduleClass[]
  bellPeriods         BellPeriod[]
  inquiries           Inquiry[]
  feeHeads            FeeHead[]
  feeStructures       FeeStructure[]
  feeInvoiceBatches   FeeInvoiceBatch[]
  feeInvoices         FeeInvoice[]
  feePayments         FeePayment[]
  feePaymentClaims    FeePaymentClaim[]
  bankStatements      BankStatement[]
  bankStatementLines  BankStatementLine[]
  discounts           Discount[]
  lateFeePolicy       LateFeePolicy?
  attendanceRecords   AttendanceRecord[]
  studentLeaves       StudentLeave[]
  staffLeaves         StaffLeave[]
  gradeScales         GradeScale[]
  terms               Term[]
  examDefinitions     ExamDefinition[]
  examResults         ExamResult[]
  smsTemplates        SmsTemplate[]
  smsLogs             SmsLog[]
  documents           Document[]
  auditLogs           AuditLog[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  classTests          ClassTest[]
  classTestScores     ClassTestScore[]
  platformInvoices    PlatformInvoice[] // SA6 vendor billing — the vendor's invoices for THIS school (non-tenant)
  StudentDocument     StudentDocument[]

  @@map("schools")
}

/// Vendor-console privilege split (SA0). SA0 enforces only two levels — SUPER_ADMIN
/// (full operator: every write) vs. read-only (SUPPORT/BILLING/ANALYST, reads only);
/// the finer per-role capabilities land in SA4.
enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
  ANALYST
}

/// Vendor-side operator (blueprint §5, §24) — NOT a tenant user. Lives outside RLS
/// (no school_id); the platform/vendor console authenticates against this table and
/// acts across tenants via the platform_admin (BYPASSRLS) connection.
model PlatformUser {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  passwordHash String?      @map("password_hash") // nullable: an INVITED operator sets it via the SA4b onboarding link
  name         String       @default("")
  role         PlatformRole @default(SUPER_ADMIN)
  status       UserStatus   @default(ACTIVE)
  mfaSecretEnc String?      @map("mfa_secret_enc") // encrypted TOTP secret (SA0)
  mfaEnabled   Boolean      @default(false) @map("mfa_enabled")
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("platform_users")
}

/// Vendor-console audit trail (SA0, SA-P2). Every platform WRITE appends a row: who
/// (operator), what action, which tenant, when — plus a reason on destructive actions.
/// NOT a tenant table — no school_id, no RLS; written on the platform_admin (BYPASSRLS)
/// connection and revoked from app_user (SA-P4).
model PlatformAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  // Nullable since SA6b: automated jobs (auto-invoice, dunning auto-suspend) have NO operator — a
  // null actor reads as "the system did this", distinct from any operator. Operator writes still set it.
  platformUserId String?  @map("platform_user_id") @db.Uuid
  action         String
  targetTenantId String?  @map("target_tenant_id") @db.Uuid
  metadata       Json?
  reason         String?
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([platformUserId])
  @@index([targetTenantId])
  @@map("platform_audit_logs")
}

/// Single-use MFA recovery codes for vendor-console operators (SA0). Mirrors
/// MfaRecoveryCode but keyed by platform_user_id (no school_id, no RLS). argon2 hashes;
/// the plaintext is shown ONCE at enrolment and is unrecoverable — used_at makes each
/// one single-use. Revoked from app_user (SA-P4).
model PlatformMfaRecoveryCode {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  codeHash       String    @unique @map("code_hash")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_mfa_recovery_codes")
}

/// Nightly fleet-wide snapshot for the vendor dashboard (SA1, SA-P7). NOT a tenant table — it
/// aggregates ACROSS all schools, so it has no school_id and lives outside RLS (on the NON_TENANT
/// allowlist in check-rls-coverage.mjs, and revoked from app_user in 06_grants.sql like every
/// platform_* table). The dashboard reads the most recent row (O(1)); the worker's
/// `platform-stats-snapshot` job writes one nightly. Computing these totals live would be a
/// COUNT(*) across every school × every student on each page load — the cost finding E avoids.
model PlatformStatsSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  capturedAt       DateTime @default(now()) @map("captured_at")
  schoolsTotal     Int      @map("schools_total")
  schoolsActive    Int      @map("schools_active")
  schoolsSuspended Int      @map("schools_suspended")
  studentsActive   Int      @map("students_active")
  staffEmployed    Int      @map("staff_employed")
  newSchools30d    Int      @map("new_schools_30d")

  @@index([capturedAt])
  @@map("platform_stats")
}

/// One-time onboarding / password-reset token for a vendor operator (SA4b). The platform mirror of
/// `password_reset_tokens`, keyed by platform_user_id — non-tenant (no school_id, no RLS), so grants
/// are its only access control (revoked from app_user in 06_grants.sql, like every platform_* table).
/// Minted when an operator is invited with no password; the operator sets their own via
/// POST /platform/auth/set-password (which flips INVITED → ACTIVE).
model PlatformPasswordResetToken {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([platformUserId])
  @@map("platform_password_reset_tokens")
}

/// Vendor billing status for a per-student invoice (SA6). ISSUED once generated; PAID when an offline
/// payment (bank transfer / cash / cheque) is recorded; VOID if cancelled. OVERDUE is DERIVED (the due
/// date passed while still ISSUED), never stored — one definition, computed on read (Law 4).
enum PlatformInvoiceStatus {
  ISSUED
  PAID
  VOID
}

/// A vendor→school invoice (SA6, decision D3: in-house per-student billing). The VENDOR bills each
/// school monthly for `student_count × price_per_student`, both FROZEN at issue time so a later
/// enrolment change or re-price never rewrites history. NOT a tenant table — it is the vendor's own
/// revenue record, so it references the school by `tenant_id` (NOT `school_id`, which the RLS-coverage
/// gate would demand a policy for) and lives on the NON_TENANT allowlist, revoked from app_user like
/// every platform_* table. `tenant_id` is ON DELETE SET NULL with a `tenant_subdomain` snapshot, so the
/// billing history SURVIVES an SA7 tenant purge — you still need to know what you invoiced and collected.
model PlatformInvoice {
  id               String                @id @default(uuid()) @db.Uuid
  tenantId         String?               @map("tenant_id") @db.Uuid
  tenantSubdomain  String                @map("tenant_subdomain") // snapshot at issue — outlives a purge
  periodYear       Int                   @map("period_year")
  periodMonth      Int                   @map("period_month") // 1–12
  studentCount     Int                   @map("student_count") // frozen ACTIVE-enrollment count at issue
  pricePerStudent  Decimal               @map("price_per_student") @db.Decimal(12, 2) // frozen rate
  amount           Decimal               @db.Decimal(12, 2) // = student_count × price_per_student, frozen
  currency         String                @default("PKR")
  status           PlatformInvoiceStatus @default(ISSUED)
  issuedAt         DateTime              @default(now()) @map("issued_at")
  dueAt            DateTime              @map("due_at")
  paidAt           DateTime?             @map("paid_at")
  paymentMethod    String?               @map("payment_method") // BANK_TRANSFER | CASH | CHEQUE | OTHER
  paymentReference String?               @map("payment_reference")
  note             String?
  createdAt        DateTime              @default(now()) @map("created_at")

  tenant School? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@unique([tenantId, periodYear, periodMonth]) // one invoice per school per month (nulls distinct → purged tenants unconstrained)
  @@index([tenantId])
  @@index([status])
  @@map("platform_invoices")
}

/// Vendor-wide billing settings (SA6c) — a SINGLE row. Non-tenant (no school_id, no RLS), revoked from
/// app_user like every platform_* table. Currently one switch: `autoReactivateOnPayment` — when a school
/// suspended for NON-PAYMENT clears its overdue balance, bring it back online automatically. Default OFF:
/// an operator must opt in, and it never un-suspends a school an operator suspended by hand (SA6c).
model PlatformSettings {
  id                      String   @id @default(uuid()) @db.Uuid
  autoReactivateOnPayment Boolean  @default(false) @map("auto_reactivate_on_payment")
  // SA6d: the single public "list" per-student price shown on the marketing site. Set by a
  // SUPER_ADMIN/BILLING operator; distinct from schools.price_per_student (each school's billed rate).
  publicPricePerStudent   Decimal  @default(20) @map("public_price_per_student") @db.Decimal(12, 2)
  updatedById             String?  @map("updated_by_id") @db.Uuid
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Where a lead is in the vendor's sales pipeline (SA8). NEW on capture; the operator advances it.
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

/// A demo / contact request from the public marketing site (SA8). Vendor-side, NOT tenant data — no
/// school_id, no RLS (allowlisted in check-rls-coverage + revoked from app_user like every platform_*
/// table, since it holds prospect PII). Captured by the PUBLIC POST /platform/public/demo-request and
/// worked from the console leads inbox (SUPER_ADMIN / SUPPORT).
model PlatformLead {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  schoolName   String?    @map("school_name")
  email        String
  phone        String?
  studentCount Int?       @map("student_count")
  message      String?
  status       LeadStatus @default(NEW)
  source       String     @default("marketing-site")
  note         String? // internal note by the operator working the lead
  handledById  String?    @map("handled_by_id") @db.Uuid
  handledAt    DateTime?  @map("handled_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("platform_leads")
}

/// Single-use rotating refresh tokens for the vendor console (blueprint §22.4, §24).
/// Mirrors RefreshToken but for platform operators (no school_id). Raw token is never
/// stored — only its SHA-256 hash; reuse of a revoked token revokes the whole family.
model PlatformRefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  platformUserId String    @map("platform_user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  familyId       String    @map("family_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([platformUserId, familyId])
  @@map("platform_refresh_tokens")
}

model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  classes       Class[]
  inquiries     Inquiry[]
  enrollments   StudentEnrollment[]
  holidays      Holiday[]
  feeStructures FeeStructure[]
  bellSchedules BellSchedule[]

  @@unique([id, schoolId]) // composite target for child tenant-chain FKs
  @@unique([schoolId, name])
  @@map("campuses")
}

model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  name      String // "2026-27"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments        StudentEnrollment[]
  terms              Term[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  feeStructures      FeeStructure[]
  invoiceBatches     FeeInvoiceBatch[]
  bellSchedules      BellSchedule[]

  @@unique([id, schoolId])
  @@unique([schoolId, name])
  // Partial unique in SQL migration: one is_current=true per school
  @@map("academic_years")
}

model Class {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  school      School   @relation(fields: [schoolId], references: [id])
  campusId    String   @map("campus_id") @db.Uuid
  campus      Campus   @relation(fields: [campusId, schoolId], references: [id, schoolId])
  name        String // "Grade 5"
  order       Int // Nursery=0, Grade1=1 …
  minAgeYears Int?     @map("min_age_years")
  maxAgeYears Int?     @map("max_age_years")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sections        Section[]
  subjects        Subject[]
  enrollments     StudentEnrollment[]
  feeStructures   FeeStructure[]
  examDefinitions ExamDefinition[]
  inquiries       Inquiry[]
  invoiceBatches  FeeInvoiceBatch[]
  bellSchedules   BellScheduleClass[]

  @@unique([id, schoolId])
  @@unique([campusId, name])
  @@index([schoolId, campusId])
  @@map("classes")
}

model Section {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  classId   String   @map("class_id") @db.Uuid
  class     Class    @relation(fields: [classId, schoolId], references: [id, schoolId])
  name      String // "A"
  capacity  Int      @default(40)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  enrollments        StudentEnrollment[]
  subjects           SectionSubject[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  coverAssignments   CoverAssignment[]
  classTests         ClassTest[]

  @@unique([id, schoolId])
  @@unique([classId, name])
  @@index([schoolId, classId])
  @@map("sections")
}

model Subject {
  id             String   @id @default(uuid()) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  school         School   @relation(fields: [schoolId], references: [id])
  classId        String   @map("class_id") @db.Uuid
  class          Class    @relation(fields: [classId, schoolId], references: [id, schoolId])
  name           String
  /// How many periods a week this subject is meant to get — the load a coordinator allocates
  /// BEFORE placing anything on the grid ("Maths 6, English 6, Urdu 5, …").
  ///
  /// **Advisory, never enforced** (same posture as `sectionCapacityMode: ADVISORY`): the editor
  /// reads "Maths — 4 of 6 placed" and nothing is ever refused, because a coordinator mid-build
  /// legitimately overshoots and rebalances afterwards. Null means the school has not allocated a
  /// load for this subject, which is different from allocating zero.
  ///
  /// Lives on `Subject` — already keyed `(classId, name)` — because the load is a class-level
  /// academic decision: every section of Grade 9 gets the same six Maths periods.
  periodsPerWeek Int?     @map("periods_per_week")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  examResults        ExamResult[]
  sections           SectionSubject[]
  teacherAssignments TeacherAssignment[]
  timetableSlots     TimetableSlot[]
  classTests         ClassTest[]

  @@unique([id, schoolId])
  @@unique([classId, name])
  @@index([classId, schoolId])
  @@map("subjects")
}

/// Which subjects a SECTION actually studies. The class owns the catalogue (so "Maths" is one
/// Subject row, keeping exam results and reports single-valued); a section opts into the ones
/// it takes. That is how electives work in practice — 9-A takes Computer, 9-B takes Biology,
/// while both share the core. Absence of rows for a section means "studies everything the
/// class offers", so existing data keeps working without a backfill.
model SectionSubject {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  school    School   @relation(fields: [schoolId], references: [id])
  sectionId String   @map("section_id") @db.Uuid
  section   Section  @relation(fields: [sectionId, schoolId], references: [id, schoolId], onDelete: Cascade)
  subjectId String   @map("subject_id") @db.Uuid
  subject   Subject  @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([sectionId, subjectId])
  @@index([schoolId, sectionId])
  @@index([subjectId, schoolId])
  @@map("section_subjects")
}

model Holiday {
  id       String   @id @default(uuid()) @db.Uuid
  schoolId String   @map("school_id") @db.Uuid
  school   School   @relation(fields: [schoolId], references: [id])
  date     DateTime @db.Date
  name     String
  campusId String?  @map("campus_id") @db.Uuid // null = all campuses
  campus   Campus?  @relation(fields: [campusId, schoolId], references: [id, schoolId])
  // ⚠️ WHEN it was declared, which is not the same as the day it describes. The notification bell
  // judges "new" on this: a closure declared tonight for tomorrow has a `date` in the future, and
  // marking it read against that date could never succeed — the badge would never clear.
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([schoolId, date, campusId])
  @@index([campusId, schoolId])
  @@map("holidays")
}

// ── Identity ─────────────────────────────────────────────────────────────────
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  schoolId            String     @map("school_id") @db.Uuid
  school              School     @relation(fields: [schoolId], references: [id])
  campusId            String?    @map("campus_id") @db.Uuid
  campus              Campus?    @relation(fields: [campusId, schoolId], references: [id, schoolId])
  email               String
  phone               String?
  passwordHash        String?    @map("password_hash") // null while INVITED
  roles               Role[]
  status              UserStatus @default(INVITED)
  failedLoginCount    Int        @default(0) @map("failed_login_count")
  lockedUntil         DateTime?  @map("locked_until")
  mfaSecretEnc        String?    @map("mfa_secret_enc") // encrypted TOTP secret
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  passwordChangedAt   DateTime?  @map("password_changed_at")
  lastLoginAt         DateTime?  @map("last_login_at")
  /// When this user last opened their notifications (Notifications Plan, N1).
  ///
  /// The whole of "unread", in one column. Notifications are DERIVED, not stored — an item is
  /// computed from the record it describes — so there is no row to carry a read flag, and
  /// anything whose record changed after this timestamp renders as new. A notifications table
  /// would have bought the same behaviour at the price of a copy of state that can disagree with
  /// the thing it copied.
  ///
  /// Null means "never opened", which correctly makes everything new on first sight.
  notificationsSeenAt DateTime?  @map("notifications_seen_at")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  parentProfile         ParentProfile?
  student               Student?           @relation("StudentLogin")
  staffProfile          StaffProfile?
  collectedPayments     FeePayment[]
  approvedDiscounts     Discount[]
  markedAttendance      AttendanceRecord[]
  markedStaffAttendance StaffAttendance[]  @relation("StaffAttendanceMarkedBy")
  arrangedCovers        CoverAssignment[]  @relation("CoverArrangedBy")
  submittedFeeClaims    FeePaymentClaim[]  @relation("ClaimSubmittedBy")
  uploadedStatements    BankStatement[]    @relation("StatementUploadedBy")
  reviewedFeeClaims     FeePaymentClaim[]  @relation("ClaimReviewedBy")
  moduleAccess          ModuleAccess[]

  // Actor back-relations. Every *_by_id column references a real user so the audit trail
  // cannot point at a ghost; `onDelete` is Prisma's default Restrict, which never fires in
  // practice because users are only ever SOFT-deleted (`deletedAt`), never removed.
  createdStudents        Student[]         @relation("StudentCreatedBy")
  createdInquiries       Inquiry[]
  admittedStudents       Admission[]
  createdInvoiceBatches  FeeInvoiceBatch[]
  approvedReversals      PaymentReversal[]
  createdGuardianCredits GuardianCredit[]
  requestedStudentLeaves StudentLeave[]    @relation("StudentLeaveRequestedBy")
  decidedStudentLeaves   StudentLeave[]    @relation("StudentLeaveDecidedBy")
  decidedStaffLeaves     StaffLeave[]
  publishedExams         ExamDefinition[]
  enteredExamResults     ExamResult[]
  approvedPayrollRuns    PayrollRun[]      @relation("PayrollRunApprovedBy")
  createdPayrollRuns     PayrollRun[]      @relation("PayrollRunCreatedBy")
  updatedSmsTemplates    SmsTemplate[]
  issuedDocuments        Document[]
  auditLogs              AuditLog[]
  createdClassTests      ClassTest[]
  mfaRecoveryCodes       MfaRecoveryCode[]
  StudentDocument        StudentDocument[]

  @@unique([id, schoolId])
  // Partial unique in 02_partial_uniques.sql: (school_id, email) WHERE deleted_at IS NULL.
  // Plain @@unique spanned removed accounts, so a departed teacher owned their address for
  // ever and re-hiring them was impossible.
  @@index([schoolId], map: "users_school_idx")
  @@index([campusId, schoolId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId, schoolId], references: [id, schoolId])
  tokenHash String    @unique @map("token_hash") // SHA-256 of the token; raw never stored
  familyId  String    @map("family_id") @db.Uuid // rotation family; reuse => revoke family
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, familyId])
  @@index([userId, schoolId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") // 30 min
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// ── People ───────────────────────────────────────────────────────────────────
model ParentProfile {
  id              String    @id @default(uuid()) @db.Uuid
  schoolId        String    @map("school_id") @db.Uuid
  school          School    @relation(fields: [schoolId], references: [id])
  /// Nullable since 2026-07-29 (scope B): guardians do not get logins, so a guardian no longer
  /// mints a login-less User + placeholder email. Legacy rows keep their link; new rows are null.
  userId          String?   @map("user_id") @db.Uuid
  user            User?     @relation(fields: [userId, schoolId], references: [id, schoolId])
  fullName        String    @map("full_name")
  /// Guardian's own contact email. Previously stored on the guardian's User row; kept here
  /// because the admission form and CSV import both collect it and discarding it silently
  /// would be worse than storing it. Not a login — no uniqueness, no auth path reads it.
  email           String?
  phone           String // normalized E.164
  /// Asked for on every Pakistani admission form and printed on board forms. The only column the
  /// Father/Mother work needed — the many-guardian shape was already modelled.
  occupation      String?
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  otpCodeHash     String?   @map("otp_code_hash") // HMAC of the current OTP (§14)
  otpExpiresAt    DateTime? @map("otp_expires_at")
  otpAttempts     Int       @default(0) @map("otp_attempts")
  smsOptOut       Boolean   @default(false) @map("sms_opt_out")
  cnicEnc         String?   @map("cnic_enc") // AES-256-GCM, per-tenant KMS data key
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  guardianLinks StudentGuardian[]

  @@unique([id, schoolId])
  @@unique([userId])
  @@unique([userId, schoolId]) // composite target for one-to-one relation from User
  @@index([schoolId, phone])
  @@map("parent_profiles")
}

model Student {
  id                    String        @id @default(uuid()) @db.Uuid
  schoolId              String        @map("school_id") @db.Uuid
  school                School        @relation(fields: [schoolId], references: [id])
  userId                String?       @unique @map("user_id") @db.Uuid // student portal login (audit C-8)
  user                  User?         @relation("StudentLogin", fields: [userId, schoolId], references: [id, schoolId])
  grNumber              String        @map("gr_number")
  registrationNo        String?       @map("registration_no") // admission-form reg. no (auto, per-school)
  cnicHash              String?       @map("cnic_hash") // HMAC of the student's CNIC/B-Form — 2nd factor for the CNIC+regNo portal login (§28)
  /// AES-256-GCM ciphertext of the same CNIC. The hash above can only ever ANSWER "does this
  /// match?"; a school also has to READ a B-Form number back for board forms and certificates,
  /// which a one-way digest can never provide. Decrypted only by the audited reveal endpoint
  /// (OWNER/CAMPUS_ADMIN) — never included in a profile payload. Departs from the teacher-CNIC
  /// write-only rule deliberately; see Key Decisions.
  cnicEnc               String?       @map("cnic_enc")
  fullName              String        @map("full_name")
  gender                Gender
  dateOfBirth           DateTime      @map("date_of_birth") @db.Date
  photoKey              String?       @map("photo_key")
  /// Admission-record fields (Admission Form Field Gaps, Tier 1). All nullable: every student
  /// admitted before this migration has none, and a walk-in is still seated in under a minute.
  ///
  /// A plain string, NOT an enum: a school may legitimately need "Parsi", "Ahmadi" or a spelling
  /// its board uses, and an enum would mean a migration per addition. The form offers the common
  /// set and allows anything.
  religion              String?
  /// The home. Absent entirely until now, which blocked transport routing, leaving certificates
  /// and any legal correspondence.
  addressLine           String?       @map("address_line")
  city                  String?
  /// ⚠️ The person you ring when a child is hurt — DELIBERATELY not the fee-paying guardian, and
  /// deliberately not a `ParentProfile`: it is often a neighbour or an uncle with no custodial
  /// relationship to model. Three plain columns say exactly that and nothing more.
  emergencyName         String?       @map("emergency_name")
  emergencyPhone        String?       @map("emergency_phone")
  emergencyRelation     String?       @map("emergency_relation")
  /// Previous academic history (Tier 2) — needed for any TRANSFER admission, which above KG is
  /// most of them. Collected after the child is seated, not at the counter.
  previousSchool        String?       @map("previous_school")
  lastClassPassed       String?       @map("last_class_passed")
  lastResult            String?       @map("last_result")
  reasonForLeaving      String?       @map("reason_for_leaving")
  /// ⚠️ Tri-state on purpose: `null` = never asked, `false` = asked and NOT received, `true` = in
  /// hand. A plain boolean cannot tell "we have not chased this yet" from "the old school is
  /// withholding it over unpaid fees" — and that second case is the one that surfaces at board
  /// registration months later, when it is far too late to fix.
  slcReceived           Boolean?      @map("slc_received")
  /// Welfare (Tier 2). `medicalNotes` is duty-of-care: the teacher on a trip needs to know about
  /// the asthma or the nut allergy, and "nobody wrote it down" is not a defence.
  bloodGroup            String?       @map("blood_group")
  medicalNotes          String?       @map("medical_notes")
  nationality           String?
  /// Not redundant with `addressLine`: families commonly keep a city residence and a village
  /// hometown, and during long holidays the hometown is the only address that reaches them.
  permanentAddress      String?       @map("permanent_address")
  /// Derived mirror of `status == ACTIVE`, kept in sync on every status write. Many reads
  /// still filter on it; retire once those move to `status`.
  isActive              Boolean       @default(true) @map("is_active")
  status                StudentStatus @default(ACTIVE)
  /// Parent/guardian declaration accepted at admission (Tier 3).
  ///
  /// ⚠️ VERSIONED on purpose. The declaration is a legal artifact — "the parent agreed" is close to
  /// worthless without "agreed to WHAT", and the wording changes as fee policy and rules change. A
  /// bare boolean would leave the school unable to say which text was in front of the parent, which
  /// is exactly the question asked when it is disputed.
  declarationVersion    String?       @map("declaration_version")
  declarationAcceptedAt DateTime?     @map("declaration_accepted_at")
  /// WHO accepted, in their own words — the parent's name as given, not a user id: the person
  /// signing an admission declaration usually has no login at that moment.
  declarationAcceptedBy String?       @map("declaration_accepted_by")
  statusReason          String?       @map("status_reason")
  statusEffectiveFrom   DateTime?     @map("status_effective_from") @db.Date
  statusEndsOn          DateTime?     @map("status_ends_on") @db.Date // SUSPENDED only — auto-restore date
  deletedAt             DateTime?     @map("deleted_at")
  createdById           String?       @map("created_by_id") @db.Uuid
  createdBy             User?         @relation("StudentCreatedBy", fields: [createdById, schoolId], references: [id, schoolId])
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  guardians   StudentGuardian[]
  feeClaims   FeePaymentClaim[]
  enrollments StudentEnrollment[]
  admission   Admission?
  invoices    FeeInvoice[]
  discounts   Discount[]
  leaves      StudentLeave[]
  documents   StudentDocument[]

  @@unique([id, schoolId])
  // Partial uniques in 02_partial_uniques.sql: (school_id, gr_number) and
  // (school_id, registration_no) WHERE deleted_at IS NULL. A plain @@unique spans
  // soft-deleted rows, so a mis-keyed admission held its GR number for ever. Deleting
  // means "this record should never have existed" (students.service.softDelete refuses
  // once fees or certificates exist), so only mistakes free their number — a withdrawn
  // or struck-off student is NOT deleted and keeps theirs.
  @@unique([userId, schoolId]) // composite target for one-to-one relation from User
  @@index([schoolId, status])
  @@index([createdById, schoolId])
  @@map("students")
}

model StudentGuardian {
  id        String           @id @default(uuid()) @db.Uuid
  schoolId  String           @map("school_id") @db.Uuid
  studentId String           @map("student_id") @db.Uuid
  student   Student          @relation(fields: [studentId, schoolId], references: [id, schoolId], onDelete: Cascade)
  parentId  String           @map("parent_id") @db.Uuid
  parent    ParentProfile    @relation(fields: [parentId, schoolId], references: [id, schoolId])
  relation  GuardianRelation
  isPrimary Boolean          @default(false) @map("is_primary")

  @@unique([studentId, parentId])
  // Partial unique in SQL migration: one is_primary=true per student
  @@index([schoolId, parentId])
  @@index([studentId, schoolId])
  @@map("student_guardians")
}

model StudentEnrollment {
  id             String           @id @default(uuid()) @db.Uuid
  schoolId       String           @map("school_id") @db.Uuid
  school         School           @relation(fields: [schoolId], references: [id])
  studentId      String           @map("student_id") @db.Uuid
  student        Student          @relation(fields: [studentId, schoolId], references: [id, schoolId])
  academicYearId String           @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear     @relation(fields: [academicYearId, schoolId], references: [id, schoolId])
  campusId       String           @map("campus_id") @db.Uuid
  campus         Campus           @relation(fields: [campusId, schoolId], references: [id, schoolId])
  classId        String           @map("class_id") @db.Uuid
  class          Class            @relation(fields: [classId, schoolId], references: [id, schoolId])
  sectionId      String           @map("section_id") @db.Uuid
  section        Section          @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  rollNumber     Int?             @map("roll_number")
  status         EnrollmentStatus @default(ACTIVE)
  startedAt      DateTime         @default(now()) @map("started_at")
  endedAt        DateTime?        @map("ended_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  attendanceRecords AttendanceRecord[]
  invoices          FeeInvoice[]
  examResults       ExamResult[]
  classTestScores   ClassTestScore[]

  @@unique([id, schoolId])
  // Partial unique in SQL migration: one status=ACTIVE per (student, academic_year)
  @@unique([sectionId, academicYearId, rollNumber])
  @@index([schoolId, academicYearId, sectionId, status])
  @@index([studentId])
  @@index([classId, schoolId])
  @@index([studentId, schoolId])
  @@index([sectionId, schoolId])
  @@index([campusId, schoolId])
  @@map("student_enrollments")
}

model StaffProfile {
  id               String           @id @default(uuid()) @db.Uuid
  schoolId         String           @map("school_id") @db.Uuid
  school           School           @relation(fields: [schoolId], references: [id])
  userId           String           @unique @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId, schoolId], references: [id, schoolId])
  staffType        StaffType        @map("staff_type")
  employeeCode     String           @map("employee_code")
  /// The person's name. Without it the directory could only identify staff by email, which is
  /// not how any school refers to its people. Nullable for rows created before this existed.
  fullName         String?          @map("full_name")
  designation      String
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  joinedAt         DateTime         @map("joined_at") @db.Date
  leftAt           DateTime?        @map("left_at") @db.Date
  bankAccountEnc   String?          @map("bank_account_enc")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  assignments      TeacherAssignment[]
  timetableSlots   TimetableSlot[]
  coveringFor      CoverAssignment[]   @relation("CoverCovering")
  coveredWhileAway CoverAssignment[]   @relation("CoverAbsent")
  attendance       StaffAttendance[]
  leaves           StaffLeave[]
  salaryStructures SalaryStructure[]
  payslips         Payslip[]

  @@unique([id, schoolId])
  @@unique([schoolId, employeeCode])
  @@unique([userId, schoolId]) // composite target for one-to-one relation from User
  @@map("staff_profiles")
}

model TeacherAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  staffId        String       @map("staff_id") @db.Uuid
  staff          StaffProfile @relation(fields: [staffId, schoolId], references: [id, schoolId])
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId])
  sectionId      String       @map("section_id") @db.Uuid
  section        Section      @relation(fields: [sectionId, schoolId], references: [id, schoolId])
  subjectId      String?      @map("subject_id") @db.Uuid // null => homeroom/class-teacher of the section
  subject        Subject?     @relation(fields: [subjectId, schoolId], references: [id, schoolId])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([staffId, academicYearId, sectionId, subjectId])
  @@index([schoolId, academicYearId, sectionId])
  @@index([sectionId, schoolId])
  @@index([subjectId, schoolId])
  @@index([staffId, schoolId])
  @@map("teacher_assignments")
}

// ── Admissions ───────────────────────────────────────────────────────────────
model Inquiry {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  school         School        @relation(fields: [schoolId], references: [id])
  campusId       String        @map("campus_id") @db.Uuid
  campus         Campus        @relation(fields: [campusId, schoolId], references: [id, schoolId])
  guardianName   String        @map("guardian_name")
  guardianPhone  String        @map("guardian_phone") // normalized E.164
  studentName    String        @map("student_name")
  desiredClassId String        @map("desired_class_id") @db.Uuid
  desiredClass   Class         @relation(fields: [desiredClassId, schoolId], references: [id, schoolId])
  status         InquiryStatus @default(INQUIRY)
  statusReason   String?       @map("status_reason") // required for REJECTED/WITHDRAWN
  createdById    String?       @map("created_by_id") @db.Uuid
  createdBy      User?         @relation(fields: [createdById, schoolId], references: [id, schoolId])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  entryTest EntryTest?
  admission Admission?

  @@unique([id, schoolId])
  @@index([schoolId, campusId, status])
  @@index([schoolId, guardianPhone])
  @@index([desiredClassId, schoolId])
  @@index([createdById, schoolId])
  @@map("inquiries")
}

model EntryTest {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  inquiryId   String   @unique @map("inquiry_id") @db.Uuid
  inquiry     Inquiry  @relation(fields: [inquiryId, schoolId], references: [id, schoolId])
  scheduledAt DateTime @map("scheduled_at")
  score       Decimal? @db.Decimal(5, 2)
  remarks     String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([inquiryId, schoolId]) // composite target for one-to-one relation from Inquiry
  @@map("entry_tests")
}

model Admission {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  inquiryId    String   @unique @map("inquiry_id") @db.Uuid
  inquiry      Inquiry  @relation(fields: [inquiryId, schoolId], references: [id, schoolId])
  studentId    String   @unique @map("student_id") @db.Uuid
  student      Student  @relation(fields: [studentId, schoolId], references: [id, schoolId])
  admittedAt   DateTime @default(now()) @map("admitted_at")
  admittedById String   @map("admitted_by_id") @db.Uuid
  admittedBy   User     @relation(fields: [admittedById, schoolId], references: [id, schoolId])

  @@unique([inquiryId, schoolId]) // composite targets for one-to-one relations
  @@unique([studentId, schoolId])
  @@index([admittedById, schoolId])
  @@map("admissions")
}

// ── Fees ─────────────────────────────────────────────────────────────────────
model FeeHead {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id])
  name     String // "Tuition", "Annual Fund", "Exam Fee"

  structures FeeStructure[]

  @@unique([id, schoolId])
  @@unique([schoolId, name])
  @@map("fee_heads")
}

model FeeStructure {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  campusId       String       @map("campus_id") @db.Uuid
  campus         Campus       @relation(fields: [campusId, schoolId], references: [id, schoolId])
  classId        String       @map("class_id") @db.Uuid
  class          Class        @relation(fields: [classId, schoolId], references: [id, schoolId])
  feeHeadId      String       @map("fee_head_id") @db.Uuid
  feeHead        FeeHead      @relation(fields: [feeHeadId, schoolId], references: [id, schoolId])
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId])
  amount         Decimal      @db.Decimal(12, 2)
  frequency      FeeFrequency

  /// The month this price starts applying from. A fee revision is a NEW row with a later
  /// date, never an edit of the old one — invoices already issued were computed from the
  /// price in force at the time, and rewriting it would silently restate what families were
  /// charged. Invoicing picks the latest row whose `effectiveFrom` is on or before the month
  /// being billed. Mirrors `SalaryStructure.effectiveFrom`.
  effectiveFrom DateTime @default(dbgenerated("CURRENT_DATE")) @map("effective_from") @db.Date

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Includes `effectiveFrom`, so one class/head/frequency can hold a price history. Without
  /// it a school could never re-price mid-year, and a typo could never be corrected.
  @@unique([classId, feeHeadId, academicYearId, frequency, effectiveFrom])
  @@index([schoolId, campusId, classId])
  @@index([classId, schoolId])
  @@index([academicYearId, schoolId])
  @@index([feeHeadId, schoolId])
  @@map("fee_structures")
}

model FeeInvoiceBatch {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  school         School       @relation(fields: [schoolId], references: [id])
  classId        String       @map("class_id") @db.Uuid
  class          Class        @relation(fields: [classId, schoolId], references: [id, schoolId])
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId, schoolId], references: [id, schoolId])
  month          Int
  year           Int
  status         String       @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  createdById    String       @map("created_by_id") @db.Uuid
  createdBy      User         @relation(fields: [createdById, schoolId], references: [id, schoolId])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([schoolId, classId, month, year]) // idempotent generation (audit C-5)
  @@index([academicYearId, schoolId])
  @@index([createdById, schoolId])
  @@map("fee_invoice_batches")
}

model FeeInvoice {
  id           String            @id @default(uuid()) @db.Uuid
  schoolId     String            @map("school_id") @db.Uuid
  school       School            @relation(fields: [schoolId], references: [id])
  studentId    String            @map("student_id") @db.Uuid
  student      Student           @relation(fields: [studentId, schoolId], references: [id, schoolId])
  enrollmentId String            @map("enrollment_id") @db.Uuid
  enrollment   StudentEnrollment @relation(fields: [enrollmentId, schoolId], references: [id, schoolId])
  batchId      String?           @map("batch_id") @db.Uuid
  totalAmount  Decimal           @map("total_amount") @db.Decimal(12, 2)
  paidAmount   Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2) // stored, maintained transactionally
  dueDate      DateTime          @map("due_date") @db.Date
  status       FeeInvoiceStatus  @default(PENDING)
  month        Int?
  year         Int
  /// Consumer number printed on the challan and quoted in the parent's bank app (§5.3).
  /// Deterministic and unique per school so an aggregator can address exactly one invoice;
  /// null until the school switches an aggregator on, which nothing does yet.
  psid         String?           @map("psid") @db.VarChar(20)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  items    FeeInvoiceItem[]
  payments FeePayment[]
  claims   FeePaymentClaim[]

  @@unique([id, schoolId])
  // Partial unique in SQL migration: one batch-generated invoice per (student, month, year)
  @@unique([schoolId, psid])
  @@index([schoolId, studentId, status])
  @@index([schoolId, status, dueDate])
  @@index([enrollmentId, schoolId])
  @@map("fee_invoices")
}

model FeeInvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  schoolId    String          @map("school_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  invoice     FeeInvoice      @relation(fields: [invoiceId, schoolId], references: [id, schoolId], onDelete: Cascade)
  type        InvoiceItemType @default(FEE)
  feeHeadId   String?         @map("fee_head_id") @db.Uuid
  description String
  amount      Decimal         @db.Decimal(12, 2) // negative for DISCOUNT/WAIVER

  @@index([invoiceId])
  @@index([invoiceId, schoolId])
  @@map("fee_invoice_items")
}

/// Somebody says they have paid. **This is not a payment.**
///
/// An unverified claim must never mint a receipt number, move `paidAmount`, appear in
/// collections or clear a defaulter — the office reconciles against the bank statement, and a
/// screenshot is a claim until it does. Verifying one creates the real `FeePayment` through the
/// ordinary payment path, so idempotency, the row lock, the gap-free receipt sequence and the
/// receipt SMS all continue to apply unchanged.
model FeePaymentClaim {
  id       String @id @default(uuid()) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  school   School @relation(fields: [schoolId], references: [id])

  /// A family pays for a CHILD, so the claim is anchored to the student even when the invoice
  /// it settles is obvious.
  studentId String     @map("student_id") @db.Uuid
  student   Student    @relation(fields: [studentId, schoolId], references: [id, schoolId])
  invoiceId String     @map("invoice_id") @db.Uuid
  invoice   FeeInvoice @relation(fields: [invoiceId, schoolId], references: [id, schoolId])

  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  transactionRef String?       @map("transaction_ref")
  /// The date the payer says they paid — NOT when they uploaded. A transfer made on the 8th and
  /// sent in on the 12th was still made on the 8th, and the late-fee question turns on that.
  paidOn         DateTime      @map("paid_on") @db.Date
  proofFileKey   String?       @map("proof_file_key")
  note           String?       @db.VarChar(300)
  /// When a cheque becomes money (D3). Null for every other method — they are money on arrival.
  ///
  /// ⚠️ STORED, not derived from `paidOn + chequeClearingDays` at read time. A cheque accepted when
  /// the school held them 3 days must not silently re-date itself because someone later changed the
  /// setting to 7 — the clearing date is a fact about THIS cheque, agreed when it was taken.
  clearsOn       DateTime?     @map("clears_on") @db.Date

  /// The statement line that corroborates this claim, once one has been matched to it.
  /// ⚠️ EVIDENCE, not a decision: a matched line never verifies anything by itself.
  statementLine BankStatementLine?

  status          ClaimStatus @default(PENDING)
  source          ClaimSource
  submittedById   String?     @map("submitted_by_id") @db.Uuid
  submittedBy     User?       @relation("ClaimSubmittedBy", fields: [submittedById, schoolId], references: [id, schoolId])
  reviewedById    String?     @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?       @relation("ClaimReviewedBy", fields: [reviewedById, schoolId], references: [id, schoolId])
  reviewedAt      DateTime?   @map("reviewed_at")
  rejectionReason String?     @map("rejection_reason") @db.VarChar(300)

  /// Set when verified — the bridge that makes a receipt traceable back to the evidence that
  /// justified it, and a claim traceable forward to the receipt it produced.
  paymentId String?     @unique @map("payment_id") @db.Uuid
  payment   FeePayment? @relation(fields: [paymentId, schoolId], references: [id, schoolId])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Composite target for the tenant-safe relation from BankStatementLine.
  @@unique([id, schoolId])
  @@unique([paymentId, schoolId])
  @@index([schoolId, status])
  @@index([studentId, schoolId])
  @@index([invoiceId, schoolId])
  @@index([submittedById, schoolId])
  @@index([reviewedById, schoolId])
  @@map("fee_payment_claims")
}

enum ClaimStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Where a claim came in from. OFFICE claims are verified by the clerk in the same action —
/// they took the money — while anything self-submitted waits for a human to match it against
/// the bank statement.
enum ClaimSource {
  OFFICE
  STUDENT_PORTAL
  GUARDIAN_LINK
}

model FeePayment {
  id             String        @id @default(uuid()) @db.Uuid
  schoolId       String        @map("school_id") @db.Uuid
  school         School        @relation(fields: [schoolId], references: [id])
