{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "paths": {
      "@common/*": ["libs/common/src/*"],
      "@common": ["libs/common/src"],
      "@database/*": ["libs/database/src/*"],
      "@database": ["libs/database/src"]
    }
  },
  "//exclude": "This is the BACKEND project: no JSX, no DOM lib. Every front-end app has its own tsconfig and its own CI gate, and test/e2e runs in a browser page. ⚠️ `apps/*-web` is a GLOB on purpose — it was previously the single literal `apps/web`, so the four apps added by the front-end split were silently pulled in here and produced ~1000 JSX/DOM errors that had nothing to do with the backend.",
  "exclude": ["node_modules", "dist", "apps/web", "apps/*-web", "packages", "test/e2e"]
}
