{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "paths": {
      "@common/*": ["libs/common/src/*"],
      "@common": ["libs/common/src"],
      "@database/*": ["libs/database/src/*"],
      "@database": ["libs/database/src"]
    }
  },
  "//exclude": "test/e2e runs in a browser page and needs the DOM lib, which this project deliberately does not have — it has its own tsconfig, typechecked by its own CI step.",
  "exclude": ["node_modules", "dist", "apps/web", "test/e2e"]
}
